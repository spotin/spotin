## General

# The application name.
APP_NAME="Spot in®"

# The application description.
APP_DESCRIPTION="A platform that allows you to find and share your favorite spots."

# The application version.
APP_VERSION="development"

# The application URL.
APP_URL=http://localhost:8000

# The application environment. Set `production` in production.
APP_ENV=local

# The application debug mode. Set `false` in production.
APP_DEBUG=true

## Scramble
# <https://scramble.dedoc.co/>

# The API version of the application
API_VERSION="${APP_VERSION}"

## Map
# <https://maplibre.org/maplibre-gl-js/docs/> and <https://openfreemap.org/>

# The style of the maps.
MAP_STYLE_URL="https://tiles.openfreemap.org/styles/bright"

# Where the map of a new spot starts, before a point is picked. Switzerland by default.
MAP_CENTER_LATITUDE=46.8
MAP_CENTER_LONGITUDE=8.23

# The zoom of the map of a new spot, from 0 (the world) to 22.
MAP_ZOOM=6

## Administrator
# The platform administrator created by `php artisan db:seed`.

# The administrator name.
ADMIN_NAME="Administrator"

# The administrator email address.
ADMIN_EMAIL=admin@example.com

# The administrator password. Only used when the account is created.
ADMIN_PASSWORD=password

## Encryption
# <https://laravel.com/framework/docs/encryption>

# The application encryption key. Set with `php artisan key:generate`.
APP_KEY=

# The previously used encryption key. Used to decrypt old data after a key rotation.
APP_PREVIOUS_KEYS=

## Hashing
# <https://laravel.com/framework/docs/hashing>

# The driver used for hashing passwords.
HASH_DRIVER=argon2id

## Localization
# <https://laravel.com/framework/docs/localization>

# The default application locale.
APP_LOCALE=en

# The supported application locales.
APP_SUPPORTED_LOCALES="en,fr"

# The fallback locale to use when the current one is not available.
APP_FALLBACK_LOCALE=en

# The locale to use for Faker when generating fake data.
APP_FAKER_LOCALE=en_US

## Email
# <https://laravel.com/framework/docs/mail>

# The mailer used for sending emails.
MAIL_MAILER=smtp

# The mail scheme used for sending emails. Set `tls` or `ssl` in production.
MAIL_SCHEME=null

# The mail host used for sending emails.
MAIL_HOST=127.0.0.1

# The mail port used for sending emails.
MAIL_PORT=1025

# The mail username used for sending emails.
MAIL_USERNAME=null

# The mail password used for sending emails.
MAIL_PASSWORD=null

# The address used for sending emails.
MAIL_FROM_ADDRESS="hello@example.com"

# The name used for sending emails.
MAIL_FROM_NAME="${APP_NAME}"

## Sanctum
# <https://laravel.com/docs/sanctum>

# Prefix of the API tokens, which helps secret scanners to detect leaked tokens
SANCTUM_TOKEN_PREFIX=spotin_




APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
